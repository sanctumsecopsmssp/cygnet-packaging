#!/usr/bin/make -f

DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)
OSSL_MODULES_DIR = /usr/lib/$(DEB_HOST_MULTIARCH)/ossl-modules

%:
	dh $@

override_dh_auto_configure:
	cmake -S . -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr

override_dh_auto_build:
	cmake --build build

# mac_forward_test returns 77 (SKIP_RETURN_CODE) where no FIPS provider is
# present, so this passes on non-FIPS builders and still fails on a real
# MAC forwarding mismatch.
override_dh_auto_test:
	ctest --test-dir build --output-on-failure

override_dh_auto_install:
	install -Dm755 build/provider/cygnetprov.so \
		debian/cygnet-provider$(OSSL_MODULES_DIR)/cygnetprov.so
