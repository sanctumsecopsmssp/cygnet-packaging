#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:
	cmake -S . -B build \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr

override_dh_auto_build:
	cmake --build build

override_dh_auto_install:
	install -Dm755 build/provider/cygnetprov.so \
		debian/cygnet-provider/usr/lib/cygnetprov.so
